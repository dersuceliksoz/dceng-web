---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import TechnicalCard from '../components/TechnicalCard.astro';
import { profile } from '../data/profile';
import { sortPublicationsAll, selectHomeFeatured, CATEGORY_LABELS_SINGULAR } from '../lib/publications';
import { prepareEvents, formatEventDate, EVENT_TYPE_LABELS } from '../lib/events';

const pubs = sortPublicationsAll(
  await getCollection('publications', ({ data }) => (import.meta.env.PROD ? data.status !== 'draft' : true)),
);
const latest = selectHomeFeatured(pubs);
const latestHref = latest && (latest.data.url ?? (latest.data.doi ? `https://doi.org/${latest.data.doi}` : undefined));
const latestTitle = latest && (latest.data.homeTitle ?? latest.data.title);
const latestSummary = latest && (latest.data.homeSummary ?? latest.data.summary);

const events = prepareEvents(await getCollection('events'));
const upcoming = events.filter((e) => e.when === 'upcoming').slice(0, 3);

const focus = [
  {
    eyebrow: '01',
    title: 'System Design',
    graphic: 'hierarchy' as const,
    items: ['Requirements Engineering', 'System Architecture', 'Component Selection', 'Trade-off Analysis'],
  },
  {
    eyebrow: '02',
    title: 'Modeling & Simulation',
    graphic: 'nodes' as const,
    items: ['Dynamic System Modeling', 'Multi-Domain Modeling', 'Reduced-Order Modeling', 'Real-Time Simulation'],
  },
  {
    eyebrow: '03',
    title: 'Control Systems',
    graphic: 'control-loop' as const,
    items: ['Control Algorithms', 'Supervisory Control', 'State Estimation', 'Fault Management'],
  },
  {
    eyebrow: '04',
    title: 'Verification & Validation',
    graphic: 'verification' as const,
    items: ['Test Planning', 'MIL / SIL / HIL Testing', 'Rapid Prototyping', 'Test Analysis'],
  },
];
---

<Layout>
  <!-- Hero -->
  <section class="hero grid-bg">
    <div class="hero__photo" aria-hidden="true"></div>
    <div class="hero__overlay" aria-hidden="true"></div>
    <div class="container hero__inner">
      <div class="hero__text stack">
        <span class="eyebrow">{profile.heroEyebrow}</span>
        <h1>{profile.name}</h1>
        <p class="lede">{profile.brandLine}</p>
        <div class="cluster hero__actions">
          <Button href="/engineering">Engineering</Button>
          <Button href="/publications" variant="secondary">Publications</Button>
          <Button href="/academy" variant="secondary">Academy</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- Technical Focus -->
  <section class="section section--divided">
    <div class="container stack--xl stack">
      <div class="section-head stack">
        <span class="eyebrow">Technical Focus</span>
        <h2>The engineering lifecycle, end to end</h2>
      </div>
      <div class="grid">
        {
          focus.map((f) => (
            <TechnicalCard title={f.title} eyebrow={f.eyebrow} graphic={f.graphic}>
              <ul class="tcard__list">
                {f.items.map((item) => <li>{item}</li>)}
              </ul>
            </TechnicalCard>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Latest publication + upcoming activities -->
  <section class="section section--divided">
    <div class="container">
      <div class="grid--2 split">
        <div class="split__col stack">
          <span class="eyebrow">Latest Publication</span>
          {
            latest ? (
              <article class="card stack feature">
                <div class="cluster feature__meta">
                  <span class="feature__cat">{CATEGORY_LABELS_SINGULAR[latest.data.category]}</span>
                </div>
                <h3>
                  {latestHref ? (
                    <a href={latestHref} target="_blank" rel="noopener noreferrer" class="feature__link">
                      {latestTitle}
                    </a>
                  ) : (
                    latestTitle
                  )}
                </h3>
                <p class="muted">{latestSummary}</p>
                {
                  latestHref && (
                    <Button href={latestHref} target="_blank" rel="noopener noreferrer" variant="ghost">
                      Read the paper →
                    </Button>
                  )
                }
              </article>
            ) : (
              <p class="muted">No publications yet.</p>
            )
          }
        </div>

        <div class="split__col stack">
          <span class="eyebrow">Upcoming Activities</span>
          {
            upcoming.length > 0 ? (
              <ul class="stack activities">
                {upcoming.map(({ entry }) => (
                  <li class="activity">
                    <time datetime={entry.data.date.toISOString().slice(0, 10)} class="activity__date">
                      {formatEventDate(entry.data.date)}
                    </time>
                    <p class="activity__title">
                      <a href="/academy" class="activity__link">{entry.data.title}</a>
                    </p>
                    <p class="muted activity__meta">
                      {EVENT_TYPE_LABELS[entry.data.type]} · {entry.data.location}
                    </p>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="muted">No upcoming activities scheduled.</p>
            )
          }
          <Button href="/academy" variant="ghost">All Academy events →</Button>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Hero */
  .hero {
    padding-block: var(--space-3xl) var(--space-2xl);
    border-bottom: 1px solid var(--color-border);
  }
  .hero__photo {
    position: absolute;
    inset: 0;
    z-index: -2;
    background-image: url('/images/hero-background.webp');
    background-size: cover;
    background-position: center 35%;
    filter: blur(2px);
    pointer-events: none;
  }
  .hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: rgba(255, 255, 255, 0.82);
    pointer-events: none;
  }
  .hero__inner {
    position: relative;
    z-index: 1;
  }
  .hero__text {
    gap: var(--space-m);
  }
  .hero h1 {
    font-size: var(--step-4);
  }
  .hero__actions {
    margin-top: var(--space-s);
    gap: var(--space-s);
  }

  .section-head {
    max-width: 60ch;
    gap: var(--space-xs);
  }

  .tcard__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding-left: 1.1em;
    list-style: disc;
  }
  .tcard__list li {
    font-size: var(--step--1);
    line-height: 1.5;
  }

  /* Split section */
  .split {
    gap: var(--space-2xl);
  }
  .feature__cat {
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent-soft);
  }
  .feature__meta {
    justify-content: space-between;
  }
  .feature__link {
    color: inherit;
  }
  .feature__link:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .activities {
    gap: var(--space-m);
  }
  .activity {
    position: relative;
    padding-bottom: var(--space-m);
    border-bottom: 1px solid var(--color-border);
  }
  .activity__date {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-accent-soft);
  }
  .activity__title {
    font-weight: 600;
    margin-top: 0.15rem;
  }
  .activity__link {
    color: inherit;
  }
  .activity__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .activity__link:hover {
    color: var(--color-accent);
    text-decoration: none;
  }
  .activity__meta {
    font-size: var(--step--1);
  }

  @media (max-width: 760px) {
    .hero {
      padding-block: var(--space-xl);
    }
    .hero__photo {
      background-position: 65% 30%;
    }
    .hero__text {
      text-align: center;
    }
    .hero__actions {
      justify-content: center;
    }
    .split {
      gap: var(--space-xl);
    }
  }
</style>
