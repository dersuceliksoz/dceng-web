---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import Button from '../components/Button.astro';
import { withBase } from '../lib/url';
---

<Layout title="Page Not Found" description="The page you're looking for doesn't exist.">
  <PageHeader eyebrow="404" title="Page not found" lede="The page you're looking for doesn't exist or may have moved.">
    <Button href={withBase('/')}>Back to Home</Button>
  </PageHeader>
</Layout>
