---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactCard from '../components/ContactCard.astro';
import { profile } from '../data/profile';
---

<Layout title="Contact" description={`Get in touch with ${profile.name} — ${profile.location}.`}>
  <PageHeader
    eyebrow="Contact"
    title="Get in touch"
    lede="For engineering projects, technical advisory, research, or academy collaborations, feel free to get in touch."
  />

  <!-- Contact channels -->
  <section class="section section--divided">
    <div class="container stack--l stack">
      <span class="eyebrow">Channels</span>
      <div class="grid contact-grid">
        {profile.contacts.map((contact) => <ContactCard contact={contact} />)}
      </div>
      <p class="muted note">
        Placeholder channels are marked “Replace” — swap in real profile links in
        <code>src/data/profile.ts</code>.
      </p>
    </div>
  </section>
</Layout>

<style>
  .contact-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
  }
  .note {
    font-size: var(--step--1);
  }
</style>
