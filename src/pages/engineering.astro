---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import TechnicalCard from '../components/TechnicalCard.astro';
import TagList from '../components/TagList.astro';
import CollabIcon from '../components/CollabIcon.astro';
import { profile } from '../data/profile';
import { withBase } from '../lib/url';

const capabilities = [
  {
    title: 'System Design & Integration',
    items: [
      'Requirements Engineering',
      'System Architecture',
      'Component Selection',
      'Interface Definition',
      'Communication Architecture',
      'Trade-off Analysis',
    ],
  },
  {
    title: 'Modeling & Simulation',
    items: [
      'Dynamic System Modeling',
      'Multi-Domain Simulation',
      'System Identification',
      'Reduced-Order Modeling',
      'Real-Time Simulation',
      'Driver-in-the-Loop Simulation',
    ],
  },
  {
    title: 'Control System Design',
    items: ['Motion Control', 'Supervisory Control', 'State Machines', 'Energy Management', 'State Estimation', 'Fault Management'],
  },
  {
    title: 'Verification & Validation',
    items: [
      'Test Planning',
      'Code Generation',
      'Rapid Prototyping',
      'MIL / SIL / HIL Testing',
      'Test Automation',
      'Test Analysis',
    ],
  },
];

const selectedWork = [
  {
    title: 'UAV Gimbal Design & Stabilization',
    graphic: 'uav-gimbal' as const,
    body: 'Mechanical design and control system development for a three-axis UAV gimbal, including target tracking and model-based validation in Simulink.',
  },
  {
    title: 'Hybrid Vehicle Control System Design',
    graphic: 'hybrid-energy' as const,
    body: 'Motion control and energy management system development for a series-hybrid vehicle platform using model-based design.',
  },
  {
    title: 'Driver-in-the-Loop Vehicle Simulator',
    graphic: 'driver-in-loop' as const,
    body: 'Real-time simulator featuring a nonlinear off-road vehicle dynamics model for controller development and HIL validation.',
  },
  {
    title: 'AI-Based Virtual Sensor Development',
    graphic: 'virtual-sensor' as const,
    body: 'Reduced-order fluid modeling and AI-based virtual sensors for real-time applications.',
  },
];
---

<Layout title="Engineering" description="Control systems, modeling & simulation, systems engineering, and V&V work.">
  <PageHeader
    eyebrow="Engineering"
    title="Engineering systems from concept to validation"
    lede="Independent engineering across systems, control, modeling, and validation."
    photo={withBase('/images/engineering-hero-background.webp')}
  />

  <!-- Capabilities -->
  <section class="section section--divided">
    <div class="container stack--l stack">
      <span class="eyebrow">Capabilities</span>
      <div class="grid">
        {
          capabilities.map((c) => (
            <TechnicalCard title={c.title}>
              <ul class="cap__list">
                {c.items.map((item) => <li>{item}</li>)}
              </ul>
            </TechnicalCard>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Application Domains -->
  <section class="section section--divided">
    <div class="container stack--l stack">
      <span class="eyebrow">Application Domains</span>
      <TagList items={profile.domains} label="Application domains" />
    </div>
  </section>

  <!-- Collaboration Models -->
  <section class="section section--divided">
    <div class="container stack--l stack">
      <span class="eyebrow">Collaboration Models</span>
      <div class="grid">
        {
          profile.collaboration.map((c) => (
            <article class="card stack collab">
              <div class="collab__icon-tile">
                <CollabIcon variant={c.graphic as 'gear' | 'review' | 'chart' | 'book'} />
              </div>
              <h3>{c.title}</h3>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Selected Work -->
  <section class="section section--divided">
    <div class="container stack--l stack">
      <div class="section-head stack">
        <span class="eyebrow">Selected Work</span>
        <h2>Featured Projects</h2>
        <p class="muted">Selected engineering work demonstrating core technical capabilities.</p>
      </div>
      <div class="grid--2">
        {
          selectedWork.map((w) => (
            <TechnicalCard title={w.title} graphic={w.graphic}>
              {w.body}
            </TechnicalCard>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Cross-link to Contact -->
  <section class="section section--divided">
    <div class="container container--narrow crosslink">
      <p class="muted">
        Further technical information is available <a href={withBase('/contact')}>upon request</a>.
      </p>
    </div>
  </section>
</Layout>

<style>
  .section-head {
    max-width: 60ch;
    gap: var(--space-xs);
  }
  .cap__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding-left: 1.1em;
    list-style: disc;
  }
  .collab {
    align-items: center;
    gap: var(--space-s);
    text-align: center;
  }
  .collab h3 {
    font-size: var(--step-1);
  }
  .collab__icon-tile {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    border: var(--border-hairline);
    background: var(--color-surface-2);
  }
  .crosslink {
    padding-top: var(--space-m);
    font-size: var(--step-1);
  }
</style>
