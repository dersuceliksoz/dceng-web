---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import TechnicalCard from '../components/TechnicalCard.astro';
import TagList from '../components/TagList.astro';
import { profile } from '../data/profile';

const capabilities = [
  {
    title: 'Control Systems',
    body: 'Feedback and feedforward design, robust and optimal control, gain scheduling, and estimation / sensor fusion.',
  },
  {
    title: 'Modeling & Simulation',
    body: 'First-principles and data-driven models, parameter identification, and real-time-capable simulators.',
  },
  {
    title: 'Systems Engineering',
    body: 'Requirements, architecture, interface definition, and model-based systems engineering across the V-cycle.',
  },
  {
    title: 'Verification & Validation',
    body: 'Test design, SIL/HIL benches, fault injection, and traceable verification campaigns up to hardware.',
  },
];

const selectedWork = [
  {
    title: 'Control-Oriented Vehicle Dynamics Modeling',
    graphic: 'grid-plot' as const,
    body: 'Reduced-order vehicle models tuned for controller design — capturing the dynamics that matter within bandwidth.',
  },
  {
    title: 'Real-Time Simulator Development',
    graphic: 'signal' as const,
    body: 'Deterministic, real-time plant simulators for closed-loop testing under hard timing constraints.',
  },
  {
    title: 'Gimbal Stabilization Control Design',
    graphic: 'control-loop' as const,
    body: 'Multi-axis stabilization loops designed for disturbance rejection and robustness to payload variation.',
  },
  {
    title: 'SIL/HIL Validation Framework Development',
    graphic: 'nodes' as const,
    body: 'A traceable validation framework linking requirements to SIL and HIL tests with automated reporting.',
  },
];
---

<Layout title="Engineering" description="Control systems, modeling & simulation, systems engineering, and V&V work.">
  <PageHeader
    eyebrow="Engineering"
    title="Control-driven systems, from model to hardware"
    lede="Independent engineering across the full lifecycle — modeling, control design, real-time implementation, and rigorous verification."
  />

  <!-- Intro -->
  <section class="section">
    <div class="container container--narrow">
      <p class="readable">
        Work spans the path a control system takes from concept to confidence: deriving models that are honest about
        their assumptions, designing controllers that hold up under disturbance and uncertainty, and validating them
        through structured SIL/HIL pipelines before they reach hardware.
      </p>
    </div>
  </section>

  <!-- Capabilities -->
  <section class="section section--divided">
    <div class="container stack--l stack">
      <span class="eyebrow">Capabilities</span>
      <div class="grid">
        {capabilities.map((c) => <TechnicalCard title={c.title}>{c.body}</TechnicalCard>)}
      </div>
    </div>
  </section>

  <!-- Application Domains -->
  <section class="section section--divided">
    <div class="container stack--l stack">
      <span class="eyebrow">Application Domains</span>
      <TagList items={profile.domains} label="Application domains" />
    </div>
  </section>

  <!-- Collaboration Models -->
  <section class="section section--divided">
    <div class="container stack--l stack">
      <span class="eyebrow">Collaboration Models</span>
      <div class="grid">
        {
          profile.collaboration.map((c) => (
            <article class="card stack collab">
              <h3>{c.title}</h3>
              <p class="muted">{c.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Selected Work -->
  <section class="section section--divided">
    <div class="container stack--l stack">
      <div class="section-head stack">
        <span class="eyebrow">Selected Work</span>
        <h2>Representative projects</h2>
        <p class="muted">Illustrative examples — technical previews, not photographs.</p>
      </div>
      <div class="grid--2">
        {
          selectedWork.map((w) => (
            <TechnicalCard title={w.title} graphic={w.graphic}>
              {w.body}
            </TechnicalCard>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Cross-link to Publications -->
  <section class="section section--divided">
    <div class="container container--narrow crosslink">
      <p class="muted">
        Much of this work is written up in detail — see the
        <a href="/publications">Publications library</a> for white papers, articles, and engineering notes.
      </p>
    </div>
  </section>
</Layout>

<style>
  .readable {
    font-size: var(--step-1);
    line-height: 1.6;
    max-width: 65ch;
  }
  .section-head {
    max-width: 60ch;
    gap: var(--space-xs);
  }
  .collab {
    gap: var(--space-xs);
  }
  .collab h3 {
    font-size: var(--step-1);
  }
  .crosslink {
    padding-top: var(--space-m);
    font-size: var(--step-1);
  }
</style>
