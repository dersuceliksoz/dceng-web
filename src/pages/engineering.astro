---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import TechnicalCard from '../components/TechnicalCard.astro';
import TagList from '../components/TagList.astro';
import { profile } from '../data/profile';

const capabilities = [
  {
    title: 'System Design & Integration',
    items: [
      'Requirements Engineering',
      'System Architecture',
      'Component Selection',
      'Interface Definition',
      'Communication Architecture',
      'Trade-off Analysis',
    ],
  },
  {
    title: 'Modeling & Simulation',
    items: [
      'Dynamic System Modeling',
      'Multi-Domain Simulation',
      'System Identification',
      'Reduced-Order Modeling',
      'Real-Time Simulation',
      'Driver-in-the-Loop Simulation',
    ],
  },
  {
    title: 'Control System Design',
    items: ['Motion Control', 'Supervisory Control', 'State Machines', 'Energy Management', 'State Estimation', 'Fault Management'],
  },
  {
    title: 'Verification & Validation',
    items: [
      'Test Planning',
      'Code Generation',
      'Rapid Prototyping',
      'MIL / SIL / HIL Testing',
      'Test Automation',
      'Test Analysis',
    ],
  },
];

const selectedWork = [
  {
    title: 'Control-Oriented Vehicle Dynamics Modeling',
    graphic: 'grid-plot' as const,
    body: 'Reduced-order vehicle models tuned for controller design — capturing the dynamics that matter within bandwidth.',
  },
  {
    title: 'Real-Time Simulator Development',
    graphic: 'signal' as const,
    body: 'Deterministic, real-time plant simulators for closed-loop testing under hard timing constraints.',
  },
  {
    title: 'Gimbal Stabilization Control Design',
    graphic: 'control-loop' as const,
    body: 'Multi-axis stabilization loops designed for disturbance rejection and robustness to payload variation.',
  },
  {
    title: 'SIL/HIL Validation Framework Development',
    graphic: 'nodes' as const,
    body: 'A traceable validation framework linking requirements to SIL and HIL tests with automated reporting.',
  },
];
---

<Layout title="Engineering" description="Control systems, modeling & simulation, systems engineering, and V&V work.">
  <PageHeader
    eyebrow="Engineering"
    title="Engineering systems from concept to validation"
    lede="Independent engineering across systems, control, modeling, and validation."
  />

  <!-- Capabilities -->
  <section class="section section--divided">
    <div class="container stack--l stack">
      <span class="eyebrow">Capabilities</span>
      <div class="grid">
        {
          capabilities.map((c) => (
            <TechnicalCard title={c.title}>
              <ul class="cap__list">
                {c.items.map((item) => <li>{item}</li>)}
              </ul>
            </TechnicalCard>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Application Domains -->
  <section class="section section--divided">
    <div class="container stack--l stack">
      <span class="eyebrow">Application Domains</span>
      <TagList items={profile.domains} label="Application domains" />
    </div>
  </section>

  <!-- Collaboration Models -->
  <section class="section section--divided">
    <div class="container stack--l stack">
      <span class="eyebrow">Collaboration Models</span>
      <div class="grid">
        {
          profile.collaboration.map((c) => (
            <article class="card stack collab">
              <h3>{c.title}</h3>
              <p class="muted">{c.description}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Selected Work -->
  <section class="section section--divided">
    <div class="container stack--l stack">
      <div class="section-head stack">
        <span class="eyebrow">Selected Work</span>
        <h2>Featured Projects</h2>
        <p class="muted">Representative engineering work demonstrating core technical capabilities.</p>
      </div>
      <div class="grid--2">
        {
          selectedWork.map((w) => (
            <TechnicalCard title={w.title} graphic={w.graphic}>
              {w.body}
            </TechnicalCard>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Cross-link to Publications -->
  <section class="section section--divided">
    <div class="container container--narrow crosslink">
      <p class="muted">
        Further technical details are available in the <a href="/publications">Publications library</a>.
      </p>
    </div>
  </section>
</Layout>

<style>
  .section-head {
    max-width: 60ch;
    gap: var(--space-xs);
  }
  .cap__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
    padding-left: 1.1em;
    list-style: disc;
  }
  .collab {
    gap: var(--space-xs);
  }
  .collab h3 {
    font-size: var(--step-1);
  }
  .crosslink {
    padding-top: var(--space-m);
    font-size: var(--step-1);
  }
</style>
