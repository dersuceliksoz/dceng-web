---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import PublicationFilters from '../components/PublicationFilters.astro';
import PublicationList from '../components/PublicationList.astro';
import TechnicalCard from '../components/TechnicalCard.astro';
import { sortPublicationsAll, CATEGORY_LABELS } from '../lib/publications';

const all = sortPublicationsAll(
  await getCollection('publications', ({ data }) => (import.meta.env.PROD ? data.status !== 'draft' : true)),
);
const featured = all.filter((p) => p.data.featured).slice(0, 3);

const linkFor = (data: (typeof all)[number]['data']) =>
  data.url ?? (data.doi ? `https://doi.org/${data.doi}` : undefined);
---

<Layout
  title="Publications"
  description="White papers, journal & conference articles, patents, and engineering notes on control and systems engineering."
>
  <PageHeader
    eyebrow="Publications"
    title="A technical library"
    lede="Journal articles and technical papers, patents, and engineering notes — the written record of the engineering work."
    photo="/images/publications-hero-background.webp"
  />

  <!-- Featured Work -->
  {
    featured.length > 0 && (
      <section class="section section--divided">
        <div class="container stack--l stack">
          <span class="eyebrow">Featured Work</span>
          <div class="grid">
            {featured.map((p) => (
              <TechnicalCard
                title={p.data.title}
                eyebrow={CATEGORY_LABELS[p.data.category]}
                graphic={p.data.graphic}
                href={linkFor(p.data)}
              >
                {p.data.summary}
              </TechnicalCard>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- Publication Library with filters -->
  <section class="section section--divided">
    <div class="container stack--l stack">
      <span class="eyebrow">Publication Library</span>
      <div class="library stack--l stack" data-filter-root data-item-attr="data-category" data-param="cat">
        <PublicationFilters default="all" />
        <PublicationList items={all} />
        <p class="muted" data-empty hidden>No publications match this filter.</p>
      </div>
    </div>
  </section>

  <!-- White Papers & Engineering Notes -->
  <section class="section section--divided">
    <div class="container stack--l stack">
      <span class="eyebrow">White Papers & Engineering Notes</span>
      <article class="card pubs-soon stack">
        <h2>White papers and engineering notes are coming soon</h2>
        <p class="muted">
          In-depth white papers and applied engineering notes are currently in preparation and will be added to
          the library soon.
        </p>
        <span class="badge">Coming Soon</span>
      </article>
    </div>
  </section>

  <script>
    import '../scripts/filters.ts';
  </script>
</Layout>

<style>
  .pubs-soon {
    gap: var(--space-s);
    align-items: flex-start;
    max-width: 60ch;
  }

  .badge {
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    background: var(--color-surface-2);
  }
</style>
