---
/**
 * Page-level header: eyebrow label, the page h1, and an optional lede.
 * One <h1> per page lives here. Extra content (e.g. buttons) goes in the slot.
 */
interface Props {
  eyebrow?: string;
  title: string;
  lede?: string;
  class?: string;
}

const { eyebrow, title, lede, class: className } = Astro.props;
---

<header class:list={['page-header grid-bg', className]}>
  <div class="container container--narrow stack">
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </div>
</header>

<style>
  .page-header {
    padding-block: var(--space-2xl) var(--space-xl);
    border-bottom: 1px solid var(--color-border);
  }

  .page-header .container {
    margin-inline: auto;
  }

  @media (max-width: 760px) {
    .page-header {
      padding-block: var(--space-xl) var(--space-l);
    }
  }
</style>
