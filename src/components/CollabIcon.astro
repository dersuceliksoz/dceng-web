---
/**
 * Small square glyph icons for the Engineering Collaboration Models cards.
 * Pure outline (stroke-only, no fill), consistent stroke width — a compact
 * companion to PreviewGraphic's wider technical-diagram scenes. Decorative
 * only; the card's own title carries the meaning.
 */
type Variant = 'gear' | 'review' | 'chart' | 'book';

interface Props {
  variant: Variant;
  class?: string;
}

const { variant, class: className } = Astro.props;
---

<svg
  class:list={['collab-icon', className]}
  viewBox="0 0 64 64"
  aria-hidden="true"
  xmlns="http://www.w3.org/2000/svg"
>
  {
    variant === 'gear' && (
      <g>
        <circle cx="32" cy="32" r="18" />
        <circle cx="32" cy="32" r="7" />
        <line x1="50" y1="32" x2="56" y2="32" />
        <line x1="44.7" y1="44.7" x2="49" y2="49" />
        <line x1="32" y1="50" x2="32" y2="56" />
        <line x1="19.3" y1="44.7" x2="15" y2="49" />
        <line x1="14" y1="32" x2="8" y2="32" />
        <line x1="19.3" y1="19.3" x2="15" y2="15" />
        <line x1="32" y1="14" x2="32" y2="8" />
        <line x1="44.7" y1="19.3" x2="49" y2="15" />
      </g>
    )
  }

  {
    variant === 'review' && (
      <g>
        <circle cx="26" cy="26" r="16" />
        <line x1="37.3" y1="37.3" x2="50" y2="50" />
        <line x1="18" y1="22" x2="34" y2="22" />
        <line x1="18" y1="30" x2="34" y2="30" />
      </g>
    )
  }

  {
    variant === 'chart' && (
      <g>
        <polyline points="10,48 24,34 36,40 50,16" />
        <circle cx="10" cy="48" r="2.5" />
        <circle cx="24" cy="34" r="2.5" />
        <circle cx="36" cy="40" r="2.5" />
        <circle cx="50" cy="16" r="2.5" />
      </g>
    )
  }

  {
    variant === 'book' && (
      <g>
        <path d="M8 20 L32 14 L56 20 L56 46 L32 52 L8 46 Z" />
        <line x1="32" y1="14" x2="32" y2="52" />
        <line x1="15" y1="28" x2="26" y2="28" />
        <line x1="15" y1="36" x2="26" y2="36" />
        <line x1="38" y1="28" x2="49" y2="28" />
        <line x1="38" y1="36" x2="49" y2="36" />
      </g>
    )
  }
</svg>

<style>
  .collab-icon {
    width: 36px;
    height: 36px;
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
