---
/**
 * Publication Library rendered as professional list rows (not marketing cards).
 * Each row emits the data-attribute contract read by the shared filter engine:
 *   data-category, data-status, data-featured, data-date.
 * Rows are rendered in build-time sort order; the client filter only show/hides.
 */
import type { CollectionEntry } from 'astro:content';
import { CATEGORY_LABELS, formatPubDate } from '../lib/publications';
import TagList from './TagList.astro';

interface Props {
  items: CollectionEntry<'publications'>[];
  class?: string;
}

const { items, class: className } = Astro.props;

function linkFor(data: CollectionEntry<'publications'>['data']): string | undefined {
  if (data.url) return data.url;
  if (data.doi) return `https://doi.org/${data.doi}`;
  return undefined;
}
---

<ul class:list={['pub-list', className]}>
  {
    items.map(({ data }) => {
      const href = linkFor(data);
      const iso = data.date.toISOString().slice(0, 10);
      return (
        <li
          class="pub-row"
          data-category={data.category}
          data-status={data.status}
          data-featured={String(data.featured)}
          data-date={iso}
        >
          <div class="pub-row__aside">
            <time class="pub-row__date" datetime={iso}>{formatPubDate(data.date)}</time>
            <span class="pub-row__cat">{CATEGORY_LABELS[data.category]}</span>
          </div>
          <div class="pub-row__main">
            <div class="pub-row__badges">
              {data.featured && <span class="badge badge--accent">Featured</span>}
              {data.status === 'placeholder' && <span class="badge">Placeholder</span>}
            </div>
            <h3 class="pub-row__title">
              {href ? (
                <a href={href} rel="noopener noreferrer">
                  {data.title}
                </a>
              ) : (
                data.title
              )}
            </h3>
            <p class="pub-row__meta muted">
              {data.authors.join(', ')}
              {data.venue && <span> · {data.venue}</span>}
            </p>
            <p class="pub-row__summary muted">{data.summary}</p>
            {data.tags.length > 0 && <TagList items={data.tags} label={`Tags for ${data.title}`} />}
          </div>
        </li>
      );
    })
  }
</ul>

<style>
  .pub-list {
    display: flex;
    flex-direction: column;
  }

  .pub-row {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: var(--space-l);
    padding-block: var(--space-l);
    border-top: 1px solid var(--color-border);
  }
  .pub-row:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .pub-row__aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xs);
  }

  .pub-row__date {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--color-text-muted);
  }

  .pub-row__cat {
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent-soft);
  }

  .pub-row__main {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .pub-row__badges:empty {
    display: none;
  }
  .pub-row__badges {
    display: flex;
    gap: var(--space-xs);
  }

  .pub-row__title {
    font-size: var(--step-1);
    line-height: 1.3;
  }
  .pub-row__title a {
    color: var(--color-text);
  }
  .pub-row__title a:hover {
    color: var(--color-accent);
  }

  .pub-row__meta {
    font-size: var(--step--1);
  }

  .pub-row__summary {
    font-size: var(--step-0);
    line-height: 1.55;
    max-width: 65ch;
  }

  .badge {
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    color: var(--color-text-muted);
    background: var(--color-surface-2);
  }
  .badge--accent {
    color: var(--color-accent);
    border-color: var(--color-accent-soft);
    background: var(--color-surface);
  }

  @media (max-width: 760px) {
    .pub-row {
      grid-template-columns: 1fr;
      gap: var(--space-s);
    }
    .pub-row__aside {
      flex-direction: row;
      align-items: baseline;
      gap: var(--space-s);
    }
  }
</style>
