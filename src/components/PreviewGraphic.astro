---
/**
 * 16:9 inline-SVG technical placeholder. Four diagram variants, themed with the
 * site tokens. No raster images. Decorative by default; pass a `title` to expose
 * it as an image to assistive tech.
 */
type Variant = 'control-loop' | 'grid-plot' | 'signal' | 'nodes' | 'hierarchy' | 'verification';

interface Props {
  variant?: Variant;
  title?: string;
  class?: string;
}

const { variant = 'grid-plot', title, class: className } = Astro.props;

const titles: Record<Variant, string> = {
  'control-loop': 'Closed-loop control block diagram',
  'grid-plot': 'Step-response plot on a technical grid',
  signal: 'Stacked signal traces',
  nodes: 'System node graph',
  hierarchy: 'Requirements document flowing into a system hierarchy diagram',
  verification: 'Checklist flowing into a monitored, inspected waveform',
};
const label = title ?? titles[variant];
---

<figure class:list={['preview', className]} aria-hidden={title ? undefined : 'true'}>
  <svg
    viewBox="0 0 320 180"
    role={title ? 'img' : 'presentation'}
    aria-label={title ? label : undefined}
    xmlns="http://www.w3.org/2000/svg"
  >
    {title && <title>{label}</title>}

    {
      variant === 'control-loop' && (
        <g>
          <line class="ln" x1="22" y1="90" x2="60" y2="90" />
          <polygon class="ah" points="60,90 53,86 53,94" />
          <circle class="node" cx="70" cy="90" r="9" />
          <line class="ln" x1="79" y1="90" x2="106" y2="90" />
          <polygon class="ah" points="106,90 99,86 99,94" />
          <rect class="blk" x="106" y="72" width="52" height="36" rx="3" />
          <text class="lbl" x="132" y="95" text-anchor="middle">C(s)</text>
          <line class="ln" x1="158" y1="90" x2="196" y2="90" />
          <polygon class="ah" points="196,90 189,86 189,94" />
          <rect class="blk" x="196" y="72" width="52" height="36" rx="3" />
          <text class="lbl" x="222" y="95" text-anchor="middle">P(s)</text>
          <line class="ln" x1="248" y1="90" x2="300" y2="90" />
          <polygon class="ah" points="300,90 293,86 293,94" />
          <circle class="dot" cx="272" cy="90" r="2.6" />
          <path class="ln" d="M272 90 L272 150 L70 150 L70 99" fill="none" />
          <polygon class="ah" points="70,99 66,106 74,106" />
        </g>
      )
    }

    {
      variant === 'grid-plot' && (
        <g>
          <line class="grid" x1="80" y1="28" x2="80" y2="150" />
          <line class="grid" x1="130" y1="28" x2="130" y2="150" />
          <line class="grid" x1="180" y1="28" x2="180" y2="150" />
          <line class="grid" x1="230" y1="28" x2="230" y2="150" />
          <line class="grid" x1="280" y1="28" x2="280" y2="150" />
          <line class="grid" x1="40" y1="60" x2="300" y2="60" />
          <line class="grid" x1="40" y1="90" x2="300" y2="90" />
          <line class="grid" x1="40" y1="120" x2="300" y2="120" />
          <line class="axis" x1="40" y1="28" x2="40" y2="150" />
          <line class="axis" x1="40" y1="150" x2="300" y2="150" />
          <line class="setpoint" x1="44" y1="60" x2="300" y2="60" />
          <path class="curve" d="M44 142 C 78 142, 86 48, 120 58 S 188 66, 300 62" fill="none" />
        </g>
      )
    }

    {
      variant === 'signal' && (
        <g>
          <line class="grid" x1="30" y1="45" x2="300" y2="45" />
          <line class="grid" x1="30" y1="90" x2="300" y2="90" />
          <line class="grid" x1="30" y1="135" x2="300" y2="135" />
          <path class="curve" fill="none" d="M30 45 Q 47 25 64 45 T 98 45 T 132 45 T 166 45 T 200 45 T 234 45 T 268 45 T 302 45" />
          <path class="curve curve--soft" fill="none" d="M30 90 Q 42 78 54 90 T 78 90 T 102 90 T 126 90 T 150 90 T 174 90 T 198 90 T 222 90 T 246 90 T 270 90 T 294 90" />
          <path class="curve" fill="none" d="M30 135 Q 40 127 50 135 T 70 135 T 90 135 T 110 135 T 130 135 T 150 135 T 170 135 T 190 135 T 210 135 T 230 135 T 250 135 T 270 135 T 290 135" />
        </g>
      )
    }

    {
      variant === 'nodes' && (
        <g>
          <line class="ln" x1="60" y1="50" x2="120" y2="90" />
          <line class="ln" x1="60" y1="130" x2="120" y2="90" />
          <line class="ln" x1="120" y1="90" x2="180" y2="45" />
          <line class="ln" x1="120" y1="90" x2="200" y2="120" />
          <line class="ln" x1="180" y1="45" x2="260" y2="80" />
          <line class="ln" x1="180" y1="45" x2="200" y2="120" />
          <line class="ln" x1="200" y1="120" x2="260" y2="80" />
          <line class="ln" x1="200" y1="120" x2="250" y2="145" />
          <line class="ln" x1="260" y1="80" x2="250" y2="145" />
          <circle class="node" cx="60" cy="50" r="6" />
          <circle class="node" cx="60" cy="130" r="6" />
          <circle class="dot-lg" cx="120" cy="90" r="7" />
          <circle class="node" cx="180" cy="45" r="6" />
          <circle class="dot-lg" cx="200" cy="120" r="7" />
          <circle class="node" cx="260" cy="80" r="6" />
          <circle class="node" cx="250" cy="145" r="6" />
        </g>
      )
    }

    {
      variant === 'hierarchy' && (
        <g transform="translate(9, 0)">
          <path class="blk" d="M20 74 L52 74 L64 86 L64 130 L20 130 Z" />
          <path class="ln" d="M52 74 L52 86 L64 86" fill="none" />
          <line class="ln" x1="30" y1="96" x2="54" y2="96" />
          <line class="ln" x1="30" y1="105" x2="54" y2="105" />
          <line class="ln" x1="30" y1="114" x2="54" y2="114" />
          <line class="ln" x1="30" y1="123" x2="44" y2="123" />

          <line class="ln" x1="64" y1="102" x2="100" y2="102" />
          <polygon class="ah" points="100,102 93,98 93,106" />

          <rect class="ln" x="108" y="58" width="174" height="104" rx="4" fill="none" />
          <rect class="blk" x="168" y="70" width="52" height="26" rx="3" />
          <line class="ln" x1="194" y1="96" x2="194" y2="112" />
          <line class="ln" x1="140" y1="112" x2="248" y2="112" />
          <line class="ln" x1="140" y1="112" x2="140" y2="124" />
          <line class="ln" x1="194" y1="112" x2="194" y2="124" />
          <line class="ln" x1="248" y1="112" x2="248" y2="124" />
          <rect class="blk" x="118" y="124" width="44" height="26" rx="3" />
          <rect class="blk" x="172" y="124" width="44" height="26" rx="3" />
          <rect class="blk" x="226" y="124" width="44" height="26" rx="3" />
        </g>
      )
    }

    {
      variant === 'verification' && (
        <g transform="translate(20, 0)">
          <rect class="blk" x="20" y="56" width="50" height="84" rx="3" />
          <rect class="blk" x="35" y="50" width="20" height="10" rx="2" />
          <rect class="node" x="28" y="72" width="10" height="10" rx="1" />
          <path class="ln" d="M30 77 L33 80 L38 73" fill="none" />
          <line class="ln" x1="44" y1="77" x2="62" y2="77" />
          <rect class="node" x="28" y="96" width="10" height="10" rx="1" />
          <path class="ln" d="M30 101 L33 104 L38 97" fill="none" />
          <line class="ln" x1="44" y1="101" x2="62" y2="101" />
          <rect class="node" x="28" y="120" width="10" height="10" rx="1" />
          <path class="ln" d="M30 125 L33 128 L38 121" fill="none" />
          <line class="ln" x1="44" y1="125" x2="62" y2="125" />

          <line class="ln" x1="70" y1="98" x2="106" y2="98" />
          <polygon class="ah" points="106,98 99,94 99,102" />

          <rect class="blk" x="116" y="60" width="124" height="78" rx="3" />
          <path class="curve" fill="none" d="M126 120 C 142 120, 150 74, 166 84 S 206 92, 230 90" />
          <rect class="blk" x="168" y="138" width="20" height="10" />
          <line class="ln" x1="150" y1="150" x2="206" y2="150" />

          <circle class="node" cx="238" cy="126" r="13" />
          <line class="ln" x1="247.2" y1="135.2" x2="260" y2="148" />
        </g>
      )
    }
  </svg>
</figure>

<style>
  .preview {
    aspect-ratio: 16 / 9;
    width: 100%;
    margin: 0;
    background: var(--color-surface-2);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }

  .preview svg {
    width: 100%;
    height: 100%;
  }

  .ln {
    stroke: var(--color-accent-soft);
    stroke-width: 1.5;
    fill: none;
  }
  .ah {
    fill: var(--color-accent-soft);
  }
  .blk {
    fill: var(--color-surface);
    stroke: var(--color-accent);
    stroke-width: 1.5;
  }
  .node {
    fill: var(--color-surface);
    stroke: var(--color-accent);
    stroke-width: 1.5;
  }
  .dot {
    fill: var(--color-accent-soft);
  }
  .dot-lg {
    fill: var(--color-accent);
  }
  .grid {
    stroke: var(--color-border);
    stroke-width: 1;
  }
  .axis {
    stroke: var(--color-ink-soft, var(--color-text-muted));
    stroke-width: 1.5;
  }
  .setpoint {
    stroke: var(--color-text-muted);
    stroke-width: 1;
    stroke-dasharray: 4 4;
  }
  .curve {
    stroke: var(--color-accent);
    stroke-width: 2;
  }
  .curve--soft {
    stroke: var(--color-accent-soft);
    stroke-width: 1.5;
  }
  .lbl {
    fill: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 11px;
  }
</style>
